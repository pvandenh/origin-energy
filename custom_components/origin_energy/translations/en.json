{
  "config": {
    "step": {
      "user": {
        "title": "Connect to Origin Energy",
        "description": "Easiest: install the \"Origin Energy HA Setup Helper\" browser extension from this integration's repo, log in to originenergy.com.au normally, visit the account/billing page once, then open the extension's popup and copy both values below. Manual fallback (no extension): 1) Open DevTools (F12) \u2192 Network tab \u2192 tick \"Preserve log\" \u2192 log in. 2) Filter for account-info - one request appears, shaped like energy-widgets-bff-api/<uuid>/account-info; that <uuid> is your account ID (NOT your A-XXXXXXX number). 3) In that same request's Headers \u2192 Request Headers \u2192 Cookie:, copy everything between auth0= and the next semicolon - that's the cookie value.",
        "data": {
          "auth0_cookie": "Auth0 session cookie value",
          "origin_account_id": "Origin account ID (UUID)"
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate Origin Energy",
        "description": "Your stored Origin Energy session has expired. Log in again in a browser, then use DevTools \u2192 Network tab \u2192 filter for account-info \u2192 open that request's Headers \u2192 Request Headers \u2192 Cookie: line, and copy the value between auth0= and the next semicolon.",
        "data": {
          "auth0_cookie": "Auth0 session cookie value"
        }
      }
    },
    "error": {
      "invalid_cookie": "That cookie didn't work - silent re-authentication failed. Make sure you copied the full `auth0` cookie value while logged in.",
      "cannot_connect": "Could not reach Origin Energy's API, or the account ID was wrong."
    },
    "abort": {
      "already_configured": "This Origin Energy account is already configured."
    }
  },
